{
  "name": "jdoor-website",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "description": "Product website for JDoor Assist.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "generate:assets": "node scripts/generate-assets.mjs",
    "check:assets": "node scripts/generate-assets.mjs --check",
    "test": "node --test test/*.test.mjs",
    "validate": "node scripts/validate-site.mjs",
    "preview": "node scripts/preview.mjs",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=moderate",
    "check": "npm run audit && npm run check:assets && npm test && npm run validate && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "sharp": "0.35.3"
  },
  "overrides": {
    "sharp": "0.35.3"
  }
}
